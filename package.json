{
  "name": "express-js-starter",
  "version": "1.0.0",
  "description": "Reusable Express.js backend starter with MongoDB, authentication, validation, security, email, uploads, and cloud services.",
  "main": "./src/index.js",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start:dev": "node --watch ./src/index.js",
    "start": "node ./src/index.js"
  },
  "keywords": [
    "express",
    "nodejs",
    "mongodb",
    "mongoose",
    "backend",
    "rest-api",
    "authentication",
    "jwt"
  ],
